<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#0D1012" Foreground="#EDF1EF" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <UserControl.Resources>
    <Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#171B1E"/><Setter Property="Foreground" Value="#EDF1EF"/><Setter Property="BorderBrush" Value="#384146"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,10"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="Opacity" Value="0.76"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Border" Property="BorderBrush" Value="#7DEFDB"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Border" Property="Opacity" Value="0.38"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#919B9F"/><Setter Property="Padding" Value="10,8"/></Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#7DEFDB"/><Setter Property="Foreground" Value="#102822"/><Setter Property="BorderBrush" Value="#7DEFDB"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="DeviceButton" TargetType="Button" BasedOn="{StaticResource QuietButton}"><Setter Property="Padding" Value="0"/></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#15191C"/><Setter Property="Foreground" Value="#EDF1EF"/><Setter Property="BorderBrush" Value="#384146"/><Setter Property="CaretBrush" Value="#7DEFDB"/><Setter Property="Padding" Value="12,10"/><Setter Property="SelectionBrush" Value="#427B71"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#EDF1EF"/><Setter Property="Margin" Value="0,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#919B9F"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
    <Style x:Key="Title" TargetType="TextBlock"><Setter Property="FontSize" Value="25"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border BorderBrush="#2A3034" BorderThickness="0,0,0,1">
      <Grid Margin="30,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Button Tag="view:discover" Style="{StaticResource QuietButton}" Foreground="#EDF1EF" Padding="0"><StackPanel Orientation="Horizontal"><Border Width="32" Height="32" CornerRadius="16" BorderBrush="#7DEFDB" BorderThickness="1" Margin="0,0,10,0"><TextBlock Text="⇄" Foreground="#7DEFDB" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="FindYou" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></Button>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="30,0,0,0"><Button x:Name="DiscoverNav" Tag="view:discover" Content="发现" Style="{StaticResource QuietButton}" Foreground="#7DEFDB"/><Button x:Name="SessionNav" Tag="view:session" Content="互传" Style="{StaticResource QuietButton}" Visibility="Collapsed"/></StackPanel>
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Tag="view:history" Style="{StaticResource QuietButton}" ToolTip="传输记录" AutomationProperties.Name="传输记录"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE81C;" FontSize="18"/></Button>
          <Button Tag="view:settings" Style="{StaticResource QuietButton}" ToolTip="偏好设置" AutomationProperties.Name="偏好设置"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="18"/></Button>
          <Button Tag="downloads" Style="{StaticResource QuietButton}" ToolTip="接收文件夹" AutomationProperties.Name="接收文件夹"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" FontSize="18"/></Button>
          <Border BorderBrush="#2A3034" BorderThickness="1,0,0,0" Margin="16,10,0,10" Padding="16,0,0,0"><Button Tag="rename" Style="{StaticResource QuietButton}" ToolTip="修改设备名称" Padding="0"><TextBlock x:Name="DeviceName" MaxWidth="155" FontSize="12"/></Button></Border>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1">
      <Grid x:Name="discover">
        <Grid x:Name="RadarLayer" ClipToBounds="True"><Canvas x:Name="PeerNodes"/></Grid>
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="40,32,0,0" IsHitTestVisible="False"><TextBlock Text="发现设备" FontSize="20" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Ellipse Width="4" Height="4" Fill="#7DEFDB" Margin="0,0,8,0"/><TextBlock x:Name="RadarStatus" Text="搜索中" FontSize="12" Foreground="#919B9F"/></StackPanel></StackPanel>
        <Grid VerticalAlignment="Bottom" Margin="30,0,30,22"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Tag="manual" Content="＋ 通过 IP 连接" Style="{StaticResource QuietButton}" FontSize="12"/><StackPanel x:Name="PeerPager" Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0" Visibility="Collapsed"><Button Tag="previous" Content="←" Style="{StaticResource QuietButton}" ToolTip="上一组设备"/><TextBlock x:Name="PeerPage" VerticalAlignment="Center" Foreground="#919B9F"/><Button Tag="next" Content="→" Style="{StaticResource QuietButton}" ToolTip="下一组设备"/></StackPanel><TextBlock Grid.Column="2" Text="FindYou" FontSize="12" Foreground="#596366" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid>
      </Grid>
      <Grid x:Name="session" Visibility="Collapsed" Margin="40,28" MaxWidth="1200">
        <StackPanel x:Name="NoSession" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="尚未连接设备" FontSize="22" Margin="0,0,0,24"/><Button Tag="view:discover" Content="发现设备 →" Style="{StaticResource PrimaryButton}"/></StackPanel>
        <Grid x:Name="SessionContent" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="90"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Tag="view:discover" Content="←" ToolTip="返回发现" Style="{StaticResource QuietButton}" FontSize="22" VerticalAlignment="Top" Margin="-10,8,0,0"/><StackPanel Grid.Column="1"><TextBlock x:Name="SessionName" Style="{StaticResource Title}"/><TextBlock x:Name="ConnectionStatus" Foreground="#7DEFDB" FontSize="12" Margin="0,8,0,0"/></StackPanel><Button Grid.Column="2" Tag="disconnect" Content="× 断开" VerticalAlignment="Top" Margin="0,8,0,0"/></Grid>
          <Grid x:Name="TransferDrop" Grid.Row="1" AllowDrop="True" Background="Transparent">
            <Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition Height="62"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border BorderBrush="#2A3034" BorderThickness="0,1,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Tag="files" Content="↑  拖入文件或文件夹" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Padding="0"/><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="SendFile" Tag="files" Content="＋ 发送文件" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"/><Button x:Name="SendDirectory" Tag="folder" Content="发送文件夹"/></StackPanel></Grid></Border>
            <Grid Grid.Row="1" VerticalAlignment="Center"><TextBlock Text="传输动态" FontSize="13"/><TextBlock x:Name="TransferCount" HorizontalAlignment="Right" FontSize="12" Foreground="#919B9F"/></Grid>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="TransferRows"/></ScrollViewer>
            <Border x:Name="DropOutline" Grid.RowSpan="3" BorderBrush="#7DEFDB" BorderThickness="1" Background="#087DEFDB" CornerRadius="4" Visibility="Collapsed" IsHitTestVisible="False"/>
          </Grid>
        </Grid>
      </Grid>
      <Grid x:Name="history" Visibility="Collapsed" Margin="40,30" MaxWidth="1200">
        <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="传输记录" Style="{StaticResource Title}"/>
        <Border Grid.Row="1" BorderBrush="#2A3034" BorderThickness="0,1,0,1"><Grid><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Tag="filter:-1" Content="全部" Style="{StaticResource QuietButton}"/><Button Tag="filter:0" Content="收到的" Style="{StaticResource QuietButton}"/><Button Tag="filter:2" Content="发出的" Style="{StaticResource QuietButton}"/></StackPanel><TextBox x:Name="HistorySearch" Width="240" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="搜索文件或设备" AutomationProperties.Name="搜索传输记录"/></Grid></Border>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="HistoryRows"/></ScrollViewer>
      </Grid>
      <Grid x:Name="settings" Visibility="Collapsed" Margin="40,30" MaxWidth="1200">
        <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="偏好设置" Style="{StaticResource Title}"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="我的设备" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,26"/><TextBlock Text="设备名称" Style="{StaticResource Label}"/><TextBox x:Name="SettingName" MaxLength="24" Margin="0,0,0,22"/><TextBlock Text="接收文件夹" Style="{StaticResource Label}"/><DockPanel Margin="0,0,0,22"><Button DockPanel.Dock="Right" Tag="pick-download" Content="…" Width="42" Margin="10,0,0,0" ToolTip="选择文件夹"/><TextBox x:Name="SettingDownload"/></DockPanel><CheckBox x:Name="SettingAutostart" Content="登录 Windows 时启动"/><CheckBox x:Name="SettingAutoAccept" Content="自动接收文件"/><CheckBox x:Name="SettingSharing" Content="允许下载已授权的共享"/><Button Tag="save-preferences" Content="保存偏好" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,20,0,0"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="跨网络发现" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,26"/><TextBlock Text="发现服务器" Style="{StaticResource Label}"/><TextBox x:Name="SettingRelay" Margin="0,0,0,22"/><TextBlock Text="配对码" Style="{StaticResource Label}"/><TextBox x:Name="SettingRoom" MaxLength="64" Margin="0,0,0,22"/><CheckBox x:Name="SettingCloud" Content="使用公共发现通道"/><Button Tag="save-network" Content="保存并重新发现" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,20,0,0"/><Button Tag="firewall" Content="修复防火墙放行" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="0,22,0,0"/></StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,24,0,20">
              <TextBlock Text="软件更新" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
              <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap" Foreground="#919B9F" Margin="0,0,0,12"/>
              <StackPanel Orientation="Horizontal"><Button x:Name="CheckUpdate" Tag="check-update" Content="检查更新"/><Button x:Name="DownloadUpdate" Tag="download-update" Content="下载更新" Margin="10,0,0,0" Visibility="Collapsed"/></StackPanel>
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </Grid>
    </Grid>
    <Border x:Name="Notice" Grid.RowSpan="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="20,0,20,24" Padding="20,12" Background="#282F32" BorderBrush="#485358" BorderThickness="1" CornerRadius="6" Visibility="Collapsed"><TextBlock x:Name="NoticeText" TextWrapping="Wrap" MaxWidth="560"/></Border>
    <Border x:Name="DialogOverlay" Grid.RowSpan="2" Background="#99000000" Visibility="Collapsed"><Border Width="420" Padding="28" Background="#171B1E" BorderBrush="#3D494E" BorderThickness="1" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel><TextBlock x:Name="DialogTitle" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,22"/><TextBox x:Name="DialogInput" MaxLength="128"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0"><Button Tag="dialog-close" Content="取消" Margin="0,0,10,0"/><Button x:Name="DialogConfirm" Content="确定" Style="{StaticResource PrimaryButton}" IsDefault="True"/></StackPanel></StackPanel></Border></Border>
  </Grid>
</UserControl>
